# Google Maps Scraper Configuration
# Copy this file to .env and fill in your values

# MailboxLayer API Key for Email Verification
# Get your API key at: https://mailboxlayer.com/
MAILBOXLAYER_API_KEY=your_mailboxlayer_api_key_here

# Scraper Settings
ENABLE_ENRICHMENT=true
MIN_DELAY=3.0
MAX_DELAY=7.0
MAX_PAGES_PER_SITE=10
MAX_DECISION_MAKERS=5

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=False
